---
import Icon from '~/components/shared/icon.astro';
import { Button } from '../shared/button';
import { cn } from '~/libs/utils';
import { ButtonGroup } from '../shared/button-group';

interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<ButtonGroup className={cn('font-heading w-full', className)}>
	<Button
		id="dark-button"
		variant="outline"
		className="dark-button disabled:border-primary disabled:bg-primary disabled:text-primary-foreground w-1/2 text-[0.55rem] disabled:opacity-100"
	>
		<Icon name="moon" className="size-4" />
		<span>Dark</span>
	</Button>
	<Button
		id="light-button"
		variant="outline"
		className="light-button disabled:border-primary disabled:bg-primary disabled:text-primary-foreground w-1/2 text-[0.55rem] disabled:opacity-100"
	>
		<Icon name="sun" className="size-4" />
		<span>Light</span>
	</Button>
</ButtonGroup>

<script is:inline data-astro-rerun>
	(() => {
		const theme = (() => {
			const stored = localStorage?.getItem('theme') ?? '';
			if (['dark', 'light'].includes(stored)) return stored;
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		})();

		document.documentElement.setAttribute('data-theme', theme);
		window.localStorage.setItem('theme', theme);

		const selected = theme === 'dark' ? '.dark-button' : '.light-button';
		document.querySelectorAll(selected).forEach((element) => {
			element.disabled = true;
		});
	})();
</script>

<script>
	function handleToggleClick(theme: 'dark' | 'light') {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);

		const darkButtons = document.querySelectorAll('.dark-button') as NodeListOf<HTMLButtonElement>;
		const lightButtons = document.querySelectorAll(
			'.light-button'
		) as NodeListOf<HTMLButtonElement>;

		darkButtons.forEach((element) => (element.disabled = theme === 'dark'));
		lightButtons.forEach((element) => (element.disabled = theme === 'light'));
	}

	function initThemeToggle() {
		const lightButtons = document.querySelectorAll(
			'.light-button'
		) as NodeListOf<HTMLButtonElement>;
		const darkButtons = document.querySelectorAll('.dark-button') as NodeListOf<HTMLButtonElement>;

		lightButtons.forEach((element) => {
			element.addEventListener('click', () => handleToggleClick('light'));
		});

		darkButtons.forEach((element) => {
			element.addEventListener('click', () => handleToggleClick('dark'));
		});
	}

	initThemeToggle();

	document.addEventListener('astro:after-swap', () => {
		const storedTheme = localStorage.getItem('theme') || 'light';
		document.documentElement.setAttribute('data-theme', storedTheme);

		const darkButtons = document.querySelectorAll('.dark-button') as NodeListOf<HTMLButtonElement>;
		const lightButtons = document.querySelectorAll(
			'.light-button'
		) as NodeListOf<HTMLButtonElement>;

		darkButtons.forEach((element) => (element.disabled = storedTheme === 'dark'));
		lightButtons.forEach((element) => (element.disabled = storedTheme === 'light'));

		initThemeToggle();
	});
</script>
