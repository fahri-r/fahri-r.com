---
import Icon from '~/components/shared/icon.astro';
import { Button } from '../shared/button';
import { cn } from '~/libs/utils';
import { ButtonGroup } from '../shared/button-group';

interface Props {
	className?: string;
	compact?: boolean;
}

const { className, compact = false } = Astro.props;
---

{
	compact ? (
		<button
			type="button"
			data-theme-toggle
			class={cn('theme-compact', className)}
			aria-label="Switch theme"
			title="Switch theme"
		>
			<Icon name="moon" className="theme-icon-dark size-4" />
			<Icon name="sun" className="theme-icon-light size-4" />
		</button>
	) : (
		<ButtonGroup className={cn('font-heading w-full', className)}>
			<Button
				data-theme-choice="dark"
				variant="outline"
				className="disabled:border-primary disabled:bg-primary disabled:text-primary-foreground w-1/2 text-[0.55rem] disabled:opacity-100"
			>
				<Icon name="moon" className="size-4" />
				<span>Dark</span>
			</Button>
			<Button
				data-theme-choice="light"
				variant="outline"
				className="disabled:border-primary disabled:bg-primary disabled:text-primary-foreground w-1/2 text-[0.55rem] disabled:opacity-100"
			>
				<Icon name="sun" className="size-4" />
				<span>Light</span>
			</Button>
		</ButtonGroup>
	)
}

<script is:inline data-astro-rerun>
	(() => {
		const theme = (() => {
			const stored = localStorage?.getItem('theme') ?? '';
			if (['dark', 'light'].includes(stored)) return stored;
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		})();

		document.documentElement.setAttribute('data-theme', theme);
		window.localStorage.setItem('theme', theme);

		document.querySelectorAll('[data-theme-choice]').forEach((element) => {
			const selected = element.getAttribute('data-theme-choice') === theme;
			element.disabled = selected;
			element.setAttribute('aria-pressed', String(selected));
		});

		document.querySelectorAll('[data-theme-toggle]').forEach((element) => {
			const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`;
			element.setAttribute('aria-label', label);
			element.setAttribute('title', label);
		});
	})();
</script>

<script>
	type Theme = 'dark' | 'light';

	function getTheme(): Theme {
		return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
	}

	function syncThemeControls(theme: Theme) {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((element) => {
			const selected = element.dataset.themeChoice === theme;
			element.disabled = selected;
			element.setAttribute('aria-pressed', String(selected));
		});

		const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`;
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((element) => {
			element.setAttribute('aria-label', label);
			element.setAttribute('title', label);
		});
	}

	function setTheme(theme: Theme) {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
		syncThemeControls(theme);
	}

	function initThemeToggle() {
		const stored = localStorage.getItem('theme');
		setTheme(stored === 'dark' || stored === 'light' ? stored : getTheme());

		if (document.documentElement.dataset.themeBound === 'true') return;
		document.documentElement.dataset.themeBound = 'true';

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;

			const choice = event.target.closest<HTMLElement>('[data-theme-choice]');
			if (choice) {
				const theme = choice.dataset.themeChoice;
				if (theme === 'dark' || theme === 'light') setTheme(theme);
				return;
			}

			if (event.target.closest('[data-theme-toggle]')) {
				setTheme(getTheme() === 'dark' ? 'light' : 'dark');
			}
		});
	}

	initThemeToggle();

	document.addEventListener('astro:after-swap', () => {
		const stored = localStorage.getItem('theme');
		setTheme(stored === 'dark' || stored === 'light' ? stored : getTheme());
	});
</script>
