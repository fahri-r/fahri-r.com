---
import profile from '~/constants/profile';
import menu from '~/constants/menu';
import { Link } from '../shared/link';
import ThemeToggle from './theme-toggle.astro';
import { Button } from '../shared/button';
import Icon from '~/components/shared/icon.astro';
---

<div
	id="navbar"
	class="relative sticky top-0 z-90 flex min-w-3xs items-center justify-between p-4 pt-6"
>
	<section class="space-y-6">
		<a href="/" class="relative flex items-center gap-3">
			<Icon name="cloud" size={36} />
			<div>
				<p class="font-heading text-[0.7rem] font-semibold">{profile.name}</p>
				<p class="text-muted-foreground text-sm">{profile.job}</p>
			</div>
		</a>
	</section>

	<section class="flex items-center space-x-4">
		<div class="hidden items-center space-x-4 lg:flex">
			{
				menu.map((item, index) => (
					<>
						<Link
							href={item.path}
							className="w-fit text-primary font-heading text-[0.7rem] flex items-end"
							underline
						>
							{item.name}
						</Link>

						{index < menu.length - 1 && <span class="text-primary">/</span>}
					</>
				))
			}
		</div>
		<ThemeToggle />
		<Button id="btn" variant={'outline'} className="lg:hidden">
			<Icon id="burgerIcon" name="burger" size={24} />
			<Icon id="closeIcon" className="hidden" name="close" size={24} />
		</Button>
	</section>

	<section
		id="overlay"
		class="bg-background pointer-events-none absolute top-full flex h-screen w-full flex-col items-center space-y-8 p-4 pt-6 opacity-0 transition-all duration-300 ease-in-out lg:hidden"
	>
		{
			menu.map((menu) => (
				<Link
					href={menu.path}
					className="w-fit text-primary font-heading text-[0.7rem] flex items-end"
					underline
				>
					<Icon name={menu.icon} size={24} />
					{menu.name}
				</Link>
			))
		}
	</section>
</div>

<script>
	function init() {
		const overlay = document.getElementById('overlay');
		const btn = document.getElementById('btn');
		const navbar = document.getElementById('navbar');
		const burgerIcon = document.getElementById('burgerIcon');
		const closeIcon = document.getElementById('closeIcon');

		if (!btn || !overlay) return;

		btn.onclick = () => {
			const isOpen = overlay.classList.contains('opacity-0');

			overlay.classList.toggle('opacity-0');
			overlay.classList.toggle('pointer-events-none');

			closeIcon?.classList.toggle('hidden', !isOpen);
			burgerIcon?.classList.toggle('hidden', isOpen);
		};

		document.body.onclick = (e) => {
			if (!(e.target instanceof HTMLElement)) return;

			if (!navbar?.contains(e.target)) {
				overlay.classList.add('opacity-0');
				overlay.classList.add('pointer-events-none');

				closeIcon?.classList.remove('hidden');
				burgerIcon?.classList.add('hidden');
			}
		};
	}

	init();

	document.addEventListener('astro:after-swap', init);
</script>
