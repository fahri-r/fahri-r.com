---
import { Image } from 'astro:assets';
import { Link } from '../shared/link';
import type { CollectionEntry } from 'astro:content';
import { Badge } from '../shared/badge';

interface Props {
	entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;

const formattedDate = new Date(entry.data.date).toLocaleString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric'
});
---

<article class="project-entry">
	<Link
		href={`/${entry.collection}/${entry.id}`}
		className="flex flex-col items-start justify-start gap-4 no-underline sm:flex-row"
	>
		{
			entry.data.cover && (
				<div class="project-thumb">
					<Image
						src={entry.data.cover}
						alt={entry.data.title}
						width={1200}
						height={630}
						class="object-cover"
					/>
				</div>
			)
		}

		<div class="text-muted-foreground grow">
			<h3 class="project-title text-foreground">{entry.data.title}</h3>
			{entry.data.description && <p class="project-desc">{entry.data.description}</p>}

			<div class="entry-meta">
				<time datetime={entry.data.date.toISOString()}>{formattedDate}</time>

				{entry.data.category && <span>{entry.data.category}</span>}

				{
					entry.data.tools && entry.data.tools.length > 0 && (
						<div class="tag-row">
							{entry.data.tools.map((tool) => (
								<Badge variant="outline">{tool}</Badge>
							))}
						</div>
					)
				}
			</div>
		</div>
	</Link>
</article>
