---
import '~/styles/app.css';

import { SITE } from '~/constants/global';
import Head from '~/components/main/head.astro';
import Footer from '~/components/main/footer.astro';
import Sidebar from '~/components/main/sidebar.astro';
import { cn } from '~/libs/utils';
interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<!doctype html>
<html class="flex justify-center" lang={SITE.lang ?? 'en'}>
	<Head>
		<slot name="head" />
	</Head>
	<body
		id="top"
		class="bg-background text-foreground relative mx-auto flex w-full max-w-6xl flex-col lg:my-8 lg:flex-row lg:border"
	>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="bg-background z-10 border-b lg:w-64 lg:shrink-0 lg:border-r lg:border-b-0">
			<Sidebar />
			<slot name="table-of-contents" />
		</header>
		<main
			id="main-content"
			class="flex min-h-screen w-full flex-col justify-between lg:min-h-[calc(100vh-4rem)]"
		>
			<div class={cn('h-full w-full px-6 py-10 sm:px-8 lg:px-10 lg:py-12', className)}>
				<slot />
			</div>
			<Footer />
		</main>
	</body>
</html>
