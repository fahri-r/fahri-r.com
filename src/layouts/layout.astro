---
import '~/styles/app.css';

import { SITE } from '~/constants/global';
import Head from '~/components/main/head.astro';
import Footer from '~/components/main/footer.astro';
import Navbar from '~/components/main/navbar.astro';
import { cn } from '~/libs/utils';
interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<!doctype html>
<html class="flex justify-center scheme-light-dark" lang={SITE.lang ?? 'en'}>
	<Head>
		<slot name="head" />
	</Head>
	<body class={'bg-background text-foreground relative flex flex-col w-7xl max-w-7xl'}>
		<header class="bg-background sticky top-0 z-50 divide-y xl:divide-none">
			<Navbar />
			<slot name="table-of-contents" />
		</header>
		<main class="flex min-h-screen w-full flex-col justify-between">
			<div class={cn('w-full h-full items-center justify-center px-10 py-12', className)}>
				<slot />
			</div>
			<Footer />
		</main>
	</body>
</html>
