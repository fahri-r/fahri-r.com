---
import Layout from '~/layouts/layout.astro';
import PageHead from '~/components/main/page-head.astro';
import { Link } from '~/components/shared/link';
---

<Layout className="flex min-h-[60vh] flex-col justify-center gap-8">
	<PageHead slot="head" title="Page not found" noindex />

	<div class="space-y-3 text-center">
		<p class="font-heading text-[2.4rem] leading-none">404</p>
		<h1 class="text-2xl">Page not found</h1>
		<p class="text-muted-foreground mx-auto max-w-md text-[0.95rem] italic">
			Whoops, there doesn&apos;t seem to be anything here. The link may be old, or the page may have
			moved.
		</p>
	</div>

	<p class="text-center">
		<Link href="/" underline>← Back to the home page</Link>
	</p>
</Layout>
