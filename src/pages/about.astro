---
import Icon from '~/components/shared/icon.astro';
import { Image } from 'astro:assets';
import PageHead from '~/components/main/page-head.astro';
import { Link } from '~/components/shared/link';
import profile from '~/constants/profile';
import type { WorkDate } from '~/interfaces/work.interface';
import Layout from '~/layouts/layout.astro';

function workPeriod(entry: WorkDate, resign?: WorkDate): string {
	const dateOut = resign
		? new Date(resign.year, resign.month - 1).toLocaleString('en-US', {
				month: 'short',
				year: 'numeric'
			})
		: 'Present';

	const dateIn = new Date(entry.year, entry.month - 1).toLocaleString('en-US', {
		month: 'short',
		year: 'numeric'
	});

	return `${dateIn} – ${dateOut}`;
}
---

<Layout className="flex flex-col gap-8">
	<PageHead slot="head" title="About Me" />

	<div class="space-y-2">
		<h1 class="page-title">About Me</h1>
		<p class="page-lede">A little about me, where I have worked, and how to reach me.</p>
	</div>

	{/* Profile */}
	<section class="panel">
		<div class="panel-head">
			<h2>Profile</h2>
			<span class="panel-note">{profile.location}</span>
		</div>
		<div class="panel-body">
			<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] lg:items-start">
				<div class="space-y-4">
					<p>
						Hey, I&apos;m Fahri! Welcome to my spot where I keep my projects, writings, experiments,
						and thoughts along my learning journey.
					</p>
					<p>
						I am a versatile software engineer with strong experience in full-stack development,
						covering backend systems, frontend interfaces, and deployment pipelines. Over the years,
						I have contributed to projects ranging from enterprise applications to university
						platforms and organizational websites, always with the goal of solving real-world
						problems through technology. I treat programming languages as tools—not limits.
						Depending on the problem, I have worked extensively with C#, .NET,
						JavaScript/TypeScript, and SQL.
					</p>
					<p>
						If you want to stay up to date, please subscribe to the{' '}
						<a href="/rss.xml">RSS feed</a>.
					</p>
				</div>

				<figure class="space-y-2">
					<Image
						src={'/images/avatar.png'}
						alt={'Fahri Ramadhan'}
						width={630}
						height={630}
						class="photo-frame h-64 w-full object-cover lg:h-auto"
					/>
					<figcaption class="text-muted-foreground text-[0.78rem] italic">
						{profile.name}, {profile.job.toLowerCase()}
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	{/* Work Experience */}
	<section class="panel">
		<div class="panel-head">
			<h2>Work Experience</h2>
			<span class="panel-note">{profile.works.length} positions</span>
		</div>
		<div class="panel-body">
			{
				profile.works.map((job) => (
					<div class="timeline-entry">
						<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
							<h3 class="timeline-title">{job.company}</h3>
							<span class="entry-date">{workPeriod(job.entry, job.resign)}</span>
						</div>
						<p class="timeline-role">{job.role}</p>
						{job.description && <p class="timeline-text mt-1">{job.description}</p>}
					</div>
				))
			}
		</div>
	</section>

	{/* Education */}
	<section class="panel">
		<div class="panel-head">
			<h2>Education</h2>
			<span class="panel-note">{profile.education.length} schools</span>
		</div>
		<div class="panel-body">
			{
				profile.education.map((education) => (
					<div class="timeline-entry">
						<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
							<h3 class="timeline-title">{education.institution}</h3>
							<span class="entry-date">
								{education.entry} – {education.resign}
							</span>
						</div>
						<p class="timeline-role">
							{education.degree}, {education.major}
						</p>
					</div>
				))
			}
		</div>
	</section>

	{/* Contact */}
	<section class="panel">
		<div class="panel-head">
			<h2>Contact</h2>
			<span class="panel-note">{profile.socials.length} channels</span>
		</div>
		<div class="panel-body">
			<p class="text-muted-foreground mb-4 text-[0.9rem] italic">
				Feel free to reach out through any of these channels.
			</p>

			<div class="space-y-1">
				{
					profile.socials.map((social) => (
						<Link href={social.href} className="rail-link w-fit justify-start" external>
							<Icon name={social.icon} size={18} className="shrink-0" />
							{social.label}
						</Link>
					))
				}
			</div>
		</div>
	</section>
</Layout>
